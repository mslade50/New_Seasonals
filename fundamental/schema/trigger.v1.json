{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fundamental.trigger.v1",
  "title": "Observable fundamental thesis trigger ledger",
  "type": "object",
  "required": ["schema_version", "updated_at", "triggers"],
  "properties": {
    "schema_version": {"const": "fundamental-trigger.v1"},
    "updated_at": {"type": "string", "format": "date-time"},
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticker", "trigger_id", "kind", "metric", "comparator",
          "threshold", "status", "source_ids"
        ],
        "properties": {
          "ticker": {"type": "string", "minLength": 1},
          "trigger_id": {"type": "string", "minLength": 3},
          "kind": {"enum": ["PROOF", "WARNING", "KILL", "REOPEN"]},
          "metric": {"type": "string", "minLength": 2},
          "comparator": {"enum": [">", ">=", "<", "<=", "==", "!=", "CROSS_ABOVE", "CROSS_BELOW"]},
          "threshold": {},
          "prior_value": {},
          "observed_value": {},
          "observed_at": {"type": ["string", "null"], "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "status": {"enum": ["ARMED", "FIRED", "EXPIRED", "CANCELLED"]},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
