+@dataclass(frozen=True)
+class Snapshot:
+    scope: Scope
+    at: datetime
+    con_id: int
+    owned_qty: int
+    account_qty: int
+    orders: tuple[OrderView, ...]
+    complete: bool = False
+    ownership_known: bool = False
+    manual_control: bool = False
+    close_capable: bool = False
