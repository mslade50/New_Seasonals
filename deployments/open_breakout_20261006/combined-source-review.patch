+                            self.broker.cancel_exact(order, op["id"] + ":cleanup:" + order.token)
+                        except Exception:
+                            return fail("Orphaned-exit cleanup uncertain; Legend remains blocked")
+                if exits:
+                    return save()
+                return save("done")
+            return fail("Unsupported reconciliation phase")
