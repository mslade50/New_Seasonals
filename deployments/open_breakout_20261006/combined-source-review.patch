+                           and order['role'] == 'ENTRY' and order['body']['side'] == opposite
+                           and order['body'].get('account') == scope.account
+                           and order['status'] not in {'Cancelled', 'ApiCancelled', 'Filled', 'Inactive', 'REJECTED'}]
