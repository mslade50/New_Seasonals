# SPY/QQQ-native release: default signal generation requires no Databento data.
# Copy to %LOCALAPPDATA%\NewSeasonals\legend_etf\runtime.env.
# python-dotenv does not expand %LOCALAPPDATA%; replace every absolute-path and
# account placeholder below. Account IDs are identifiers, not passwords, but
# keep this file local and never commit credentials or API keys.

# The primary account is always required because its session is the
# authoritative SPY/QQQ/IWM market-data feed. Verify the actual live/paper TWS
# or Gateway ports; there is intentionally no assumed primary port here.
LEGEND_ETF_PRIMARY_ACCOUNT=YOUR_PRIMARY_ACCOUNT_ID
LEGEND_ETF_PRIMARY_HOST=127.0.0.1
LEGEND_ETF_PRIMARY_PORT=REPLACE_WITH_PRIMARY_TWS_OR_GATEWAY_PORT
LEGEND_ETF_PRIMARY_CLIENT_ID=155

# Required when --accounts includes pa. Port 4002 is the standard paper
# Gateway default; verify the configured Gateway rather than relying on it.
LEGEND_ETF_PA_ACCOUNT=YOUR_PA_PAPER_ACCOUNT_ID
LEGEND_ETF_PA_HOST=127.0.0.1
LEGEND_ETF_PA_PORT=4002
LEGEND_ETF_PA_CLIENT_ID=156

# Read-only ETF feed connection. It may share the primary host/port but must
# use a distinct client ID. Replace the port with the verified endpoint.
LEGEND_ETF_FEED_HOST=127.0.0.1
LEGEND_ETF_FEED_PORT=REPLACE_WITH_AUTHENTICATED_FEED_PORT
LEGEND_ETF_FEED_CLIENT_ID=154

# One machine-global reservation namespace shared by Legend and every patched
# external broker mutator. Use absolute paths; do not point these at a Git
# worktree. The manifest and daily budget do not exist until their separate
# integration/review steps are complete.
LEGEND_ETF_RESERVATION_DIR=C:\Users\YOUR_WINDOWS_USER\AppData\Local\NewSeasonals\legend_etf\reservations
LEGEND_ETF_EXECUTOR_ROOT=C:\Users\YOUR_WINDOWS_USER\OneDrive\trading_ibkr
LEGEND_ETF_GUARD_MANIFEST=C:\Users\YOUR_WINDOWS_USER\AppData\Local\NewSeasonals\legend_etf\executor_guard_manifest.json
LEGEND_ETF_GUARD_MANIFEST_SHA256=REPLACE_WITH_64_HEX_SHA256
LEGEND_ETF_PORTFOLIO_BUDGET=C:\Users\YOUR_WINDOWS_USER\AppData\Local\NewSeasonals\legend_etf\portfolio_budget.json

# Reviewed PA paper evidence must bind to the exact deployment-manifest hash.
# Its validator requires long and short IOC/OCA drills, partial-fill/restart/
# disconnect drills, <=1s target revisions, and a <=5s 10:30 time exit.
LEGEND_ETF_PAPER_PROOF=C:\Users\YOUR_WINDOWS_USER\AppData\Local\NewSeasonals\legend_etf\paper_proof.json
LEGEND_ETF_PAPER_PROOF_SHA256=REPLACE_WITH_64_HEX_SHA256

# The default machine-global Databento cache is
# %LOCALAPPDATA%\NewSeasonals\legend_etf\futures_cache and retains the rolling
# 150-calendar-day input window. Uncomment only to use another absolute
# machine-stable directory. Cache files require their generated SHA256
# sidecars and each run quotes a 30-calendar-day overlap refresh.
# LEGEND_ETF_DATABENTO_CACHE_DIR=C:\ABSOLUTE\MACHINE_STABLE\futures_cache

# Databento is fail-closed at $0.00. A non-zero recurring ceiling and the
# literal confirmation both require separate spend approval.
LEGEND_ETF_DATABENTO_MAX_COST_USD=0
# LEGEND_ETF_DATABENTO_MAX_COST_USD=REVIEWED_NUMERIC_CEILING
# LEGEND_ETF_DATABENTO_PAID_CONFIRMATION=I_APPROVE_DATABENTO_CHARGE

# Reviewed sizing ceilings. Values may be reduced, never increased above the
# code limits. The denominator is 1.25 x prior raw ETF Wilder ATR14; it is not
# a stop loss. Use PA_MAX_SHARES_PER_ROOT=1 for one-share paper drills.
LEGEND_ETF_PRIMARY_LONG_BPS=10
LEGEND_ETF_PRIMARY_SHORT_BPS=5
LEGEND_ETF_PRIMARY_CLUSTER_BPS=30
LEGEND_ETF_PRIMARY_MAX_SHARES_PER_ROOT=5000
LEGEND_ETF_PRIMARY_MAX_NOTIONAL_PCT=0.25
LEGEND_ETF_PA_LONG_BPS=5
LEGEND_ETF_PA_SHORT_BPS=2.5
LEGEND_ETF_PA_CLUSTER_BPS=15
LEGEND_ETF_PA_MAX_SHARES_PER_ROOT=1
LEGEND_ETF_PA_MAX_NOTIONAL_PCT=0.15

# Leave the live gate disabled. --live is also required, so neither this file
# nor task registration alone authorizes an order. Recovery of an already
# broker-mutated exact lot remains exit-only even when entry activation is off.
LEGEND_ETF_LIVE_ENABLED=0
LEGEND_ETF_LIVE_DATE=YYYY-MM-DD
LEGEND_ETF_STRATEGY_VERSION=legend-etf-spy-qqq-v2
# Exact IBKR account IDs, comma-separated; never use the CLI labels here.
LEGEND_ETF_LIVE_ACCOUNTS=REPLACE_WITH_EXACT_APPROVED_ACCOUNT_IDS
LEGEND_ETF_ALLOW_LONGS=0
LEGEND_ETF_ALLOW_SHORTS=0

# Current release status: no tasks, spend, paper order, or live date is armed.
# Do not change the gate until the external all-mutator guard, shared portfolio
# budget publisher, five shadows, and PA paper OCA/time-exit/recovery proofs are
# reviewed and retained.
