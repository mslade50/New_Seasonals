+def test_both_accounts_exit_the_same_confirmed_tranche(monkeypatch, tmp_path):
+    """Primary (olv_exit_primary) and PA (this runner) read the same row on the
+    same morning; each sells only its own full leg, journals separately."""
+    import olv_exit_primary as primary
+    _guard_inactive(monkeypatch, tmp_path)
+    _pre_open(monkeypatch)
+    monkeypatch.setattr(primary, '_now_time', lambda: _dt.time(9, 12))
+    _use_temp_journal(monkeypatch, tmp_path)
+    p_path = str(tmp_path / 'olv_exit_primary_placed.json')
+    real_pl, real_pj = primary.load_placed, primary.journal_placed
+    monkeypatch.setattr(primary, 'load_placed', lambda today, path=p_path: real_pl(today, path=path))
+    monkeypatch.setattr(primary, 'journal_placed',
+                        lambda *a, **k: real_pj(*a, **{**k, 'path': p_path}))
+
+    rows = _pa_rows(qty=494)
+
+    p_broker = _ExecBroker(account='U_PRI', client_id=99, port=7496)
+    contract = _contract('A', 42)
+    p_target = _bracket_leg(contract, 'LMT', order_id=11, account='U_PRI', qty=494, lmt=105.0)
+    p_time = _bracket_leg(contract, 'MKT', order_id=12, account='U_PRI', qty=494)
+    for leg in (p_target, p_time):
+        leg.orderStatus.filled = 0
+    p_broker.trades = [p_target, p_time]
+    p_broker.positions_value = [SimpleNamespace(account='U_PRI', contract=contract, position=494)]
+    p_broker.contract_ids['A'] = 42
+
+    pa_broker, *_ = _bracket_broker(account='U_PA', client_id=98)
+    for t in pa_broker.trades:
+        t.order.totalQuantity = 144
+        t.orderStatus.remaining = 144
+    pa_broker.positions_value[0].position = 144
+
+    p_result = primary.process_account('PRIMARY', '127.0.0.1', 7496, 99, rows, TODAY,
+                                       connected={'ib': p_broker, 'account': 'U_PRI'})
+    pa_result = _run_pa(pa_broker, rows)
+
+    assert p_result[0]['Status'] == 'SENT_OPG'
+    assert pa_result[0]['Status'] == 'SENT_OPG'
+    assert int(p_broker.place_calls[0][1].totalQuantity) == 494
+    assert p_broker.place_calls[0][1].account == 'U_PRI'
+    assert int(pa_broker.place_calls[0][1].totalQuantity) == 144
+    assert pa_broker.place_calls[0][1].account == 'U_PA'
+    assert os.path.exists(p_path)
