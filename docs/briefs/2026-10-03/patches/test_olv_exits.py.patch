+# ---------------------------------------------------------------------------
+# 2026-10-01: PA reads OLV_Exits_Primary. The scanner has written only that tab
+# since 2026-09-07, so the PA runner (still reading OLV_Exits) had no
+# vol-confirm exit coverage. A Primary row names PRIMARY's tranche and
+# quantity; PA must exit ITS OWN full live leg of the same signal (same
+# SYM|BUY|strategy|date ref, conId and time-exit date) and nothing else.
+# ---------------------------------------------------------------------------
+def _pa_rows(qty=494, execute_on=TODAY, **kw):
+    sh = _FakeSheet({runner.OLV_EXITS_TAB_NAME: _FakeWS([
+        _primary_record('A', qty, execute_on, **kw)])})
+    return runner.load_exit_rows(sh, pd.Timestamp(TODAY))
+
+
+def _run_pa(broker, rows):
+    return _run(broker, rows, label='PA', client_id=98, account='U_PA')
+
+
+def test_pa_exits_its_own_leg_when_primary_size_differs(monkeypatch, tmp_path):
+    _guard_inactive(monkeypatch, tmp_path)
+    _pre_open(monkeypatch)
+    _use_temp_journal(monkeypatch, tmp_path)
+    broker, contract, target, time_leg = _bracket_broker(account='U_PA', client_id=98)
+    for leg in (target, time_leg):
+        leg.order.totalQuantity = 144
+        leg.orderStatus.remaining = 144
+    broker.positions_value[0].position = 144
+
+    result = _run_pa(broker, _pa_rows(qty=494))        # Primary's 494, PA's 144
+
+    assert result[0]['Status'] == 'SENT_OPG'
+    assert broker.cancel_calls == [(98, 11), (98, 12)]
+    placed = broker.place_calls[0][1]
+    _assert_standalone_sell(placed, qty=144, account='U_PA')
+    assert placed.orderRef.startswith(f"{_base_sig()}|oca:OCA_A|leg:98:12")
+
+
