+def test_filter_logging_exception_also_leaves_rows(monkeypatch, capsys):
+    import builtins
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    tab = pd.DataFrame([_row('FORM', '2026-09-30', '2026-09-29')])
+    original_print = builtins.print
+    def failed_detail(*args, **kwargs):
+        if args and 'NOT re-placing' in str(args[0]):
+            raise UnicodeEncodeError('ascii', '\u2603', 0, 1, 'offline log failure')
+        return original_print(*args, **kwargs)
+    monkeypatch.setattr(builtins, 'print', failed_detail)
+    assert staging.filter_prior_day_premarket_rows(tab) is tab
+    output = capsys.readouterr().out
+    assert output.count('[CRITICAL]') == 1 and 'UnicodeEncodeError' in output
+
