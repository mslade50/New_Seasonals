--- /dev/null
+++ b/test_staging_prior_day_rows.py
@@ -0,0 +1,331 @@
+"""Offline test: order_staging must not re-place a prior day's pre-market rows.
+
+2026-10-01 near-miss: scan_pm on 9/30 was skipped and scan_am on 10/01 died
+before its Sheets writes, so the Overflow tab still held 9/30's AM-bookend row
+(FORM Overbot Vol Spike short, Scan_Date 9/30, Signal_Date 9/29) that had
+already been placed on 9/30 (Primary 498 / PA 145). The Scan_Date cutoff
+(>= today - 1 NYSE day) kept it, Staged_Date was restamped to 10/01 and both
+entry scripts would have placed it again at stale levels.
+
+The scanner writes Signal_Date = the last settled bar: an AM-bookend scan on D
+stamps D-1, a PM-bookend scan on D stamps D. filter_prior_day_premarket_rows
+drops a row only when Scan_Date < today AND Signal_Date < the previous NYSE
+session. Cases:
+  1. the 10/01 scenario -> nothing staged, loud [CRITICAL] line that the
+     morning summary email flags
+  2. normal AM day (today's scan) -> unchanged, same object, silent
+  3. AM failed but yesterday's PM scan ran -> kept (designed fallback)
+  4. preserve_unavailable retention of a PM row kept, of an AM row dropped
+  5. every persistent multi-day entry (GTC/GTD fill window): day-1 rows from
+     either bookend are kept; the day-2..T+N window is the broker-resting GTD
+     parent, never a re-read of the tab
+  6. weekend / holiday / Thanksgiving boundaries on the NYSE calendar
+  7. blank Signal_Date and an operator row stamped today are left alone
+  8. pull_and_stage_orders end to end: the 10/01 tab stages nothing and
+     writes no execution tab; a normal day stages the row
+"""
+import pandas as pd
+import pytest
+
+import morning_order_summary as mos
+import order_staging as staging
+from trading_calendar_live import TRADING_DAY
+
+
+def _freeze(monkeypatch, when):
+    fixed = pd.Timestamp(when)
+    monkeypatch.setattr(pd.Timestamp, 'now', classmethod(lambda cls, tz=None: fixed))
+
+
+def _row(symbol, scan, signal, strategy='Overbot Vol Spike', action='SELL', **kw):
+    row = {'Scan_Date': scan, 'Signal_Date': signal, 'Symbol': symbol,
+           'Action': action, 'Quantity': 100, 'Strategy_Ref': strategy}
+    row.update(kw)
+    return row
+
+
+def _load(df, label='overflow'):
+    """The exact sequence pull_and_stage_orders applies to each staging tab."""
+    df = staging.filter_stale_overflow(df, label=label)
+    return staging.filter_prior_day_premarket_rows(df, label=label)
+
+
+# --- 1. the 2026-10-01 scenario -------------------------------------------
+def test_oct1_scenario_drops_prior_day_am_row(monkeypatch, capsys):
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    tab = pd.DataFrame([_row('FORM', '2026-09-30', '2026-09-29', Quantity=498)])
+    out = _load(tab)
+    assert out.empty
+    msg = capsys.readouterr().out
+    assert '[CRITICAL]' in msg and 'FORM SELL Overbot Vol Spike' in msg
+    assert 'signal 2026-09-29, scan 2026-09-30' in msg
+    line = next(ln for ln in msg.splitlines() if '[CRITICAL]' in ln)
+    assert mos._FAIL_RE.match(line), "the morning summary must flag this line"
+
+
+def test_oct1_line_turns_summary_email_red(tmp_path, monkeypatch, capsys):
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    _load(pd.DataFrame([_row('FORM', '2026-09-30', '2026-09-29')]))
+    line = next(ln for ln in capsys.readouterr().out.splitlines() if '[CRITICAL]' in ln)
+    log = (f"===== RUN START Thu 10/01/2026  9:31:01.45 ===== \n"
+           "===== STEP 1: order_staging.py ===== \n"
+           f"{line}\n[WARN] No orders to process.\n"
+           "[order_staging.py exit code: 0] \n \n"
+           "===== RUN END Thu 10/01/2026  9:31:30.22 ===== \n")
+    p = tmp_path / 'order_staging_last_run.log'
+    p.write_text(log, encoding='utf-8')
+    monkeypatch.setattr(mos, 'STAGING_LOG', p)
+    r = mos.staging_failure('10/01/2026')
+    assert r and 'exited 0 but logged' in r and 'prior day' in r
+
+
+# --- 2/3. normal days ------------------------------------------------------
