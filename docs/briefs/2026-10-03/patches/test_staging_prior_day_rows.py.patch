+# --- 5. persistent multi-day entries ---------------------------------------
+# (strategy, hold_days, fill_window_days) as in strategy_config; every one is
+# entry_type "... (Persistent)" -> Order_Type REL_CLOSE, TIF GTC.
+PERSISTENT = [
+    ('Oversold Low Volume', 10, 3),
+    ('Monthly Weak Close', 5, 2),
+    ('52wh Breakout', 63, 10),
+    ('Sector BO', 63, 10),
+    ('LT Trend ST OS', 1, 1),
+    ('St OS Sznl', 5, 5),
+    ('Indices Oversold Bounce', 2, 2),
+]
+
+
+def _persistent_row(strategy, hold, fw, scan, signal):
+    sig = pd.Timestamp(signal)
+    exit_date = (sig + TRADING_DAY + hold * TRADING_DAY).date()
+    return _row('TKR', scan, signal, strategy, 'BUY', Order_Type='REL_CLOSE', TIF='GTC',
+                Hold_Days=hold, Fill_Window_Days=fw, Time_Exit_Date=str(exit_date))
+
+
+@pytest.mark.parametrize('strategy,hold,fw', PERSISTENT)
+def test_persistent_day1_rows_kept_from_either_bookend(monkeypatch, strategy, hold, fw):
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    am = _persistent_row(strategy, hold, fw, '2026-10-01', '2026-09-30')
+    pm = _persistent_row(strategy, hold, fw, '2026-09-30', '2026-09-30')
+    assert len(_load(pd.DataFrame([am]))) == 1
+    assert len(_load(pd.DataFrame([pm]))) == 1
+
+
+@pytest.mark.parametrize('strategy,hold,fw', PERSISTENT)
+def test_persistent_window_rests_at_broker_not_on_the_tab(monkeypatch, strategy, hold, fw):
+    # Day 1 (10/01) stages the row once; order_staging back-computes the GTD
+    # parent expiry as Time_Exit_Date - (1 + hold - fw) trading days, which is
+    # signal + fw sessions: the whole T+1..T+fw window is covered by that one
+    # broker order. On day 2 the same tab row (left by a dead scan) is 10/01's
+    # entry, so re-staging it would be a second order, not the window.
+    row = _persistent_row(strategy, hold, fw, '2026-10-01', '2026-09-30')
+    exit_dt = pd.to_datetime(row['Time_Exit_Date'])
+    expiry = (exit_dt - (1 + hold - fw) * TRADING_DAY).date()
+    assert expiry == (pd.Timestamp('2026-09-30') + fw * TRADING_DAY).date()
+
+    _freeze(monkeypatch, '2026-10-02 09:31')
+    assert _load(pd.DataFrame([row])).empty
+
+
+def test_moc_and_trend_tabs_are_not_read_by_this_loader():
+    import inspect
+    reader = inspect.getsource(staging._read_staging_tabs_with_retry)
+    assert 'worksheet(TAB_NAME)' in reader and 'worksheet(OVERFLOW_TAB_NAME)' in reader
+    assert 'moc' not in reader.lower() and 'TREND' not in reader
+    body = inspect.getsource(staging.pull_and_stage_orders)
+    assert "filter_prior_day_premarket_rows(df_main, label='liquid')" in body
+    assert 'filter_prior_day_premarket_rows(df_overflow)' in body
+    # Trend rows join after the filters and carry no Scan_Date/Signal_Date.
+    assert body.index('filter_prior_day_premarket_rows(df_overflow)') < body.index('load_trend_rows(sh)')
+
