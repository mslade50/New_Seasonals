+def test_filter_unexpected_exception_leaves_all_rows(monkeypatch, capsys):
+    tab = pd.DataFrame([_row('FORM', '2026-09-30', '2026-09-29')])
+    def broken_now(*_args, **_kwargs):
+        raise RuntimeError('bad clock')
+    monkeypatch.setattr(pd.Timestamp, 'now', broken_now)
+    assert staging.filter_prior_day_premarket_rows(tab) is tab
+    assert capsys.readouterr().out.count('[CRITICAL]') == 1
+
