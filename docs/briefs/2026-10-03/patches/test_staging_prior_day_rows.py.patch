+# --- 8. pull_and_stage_orders end to end (no broker, no Sheets) -------------
+def _full_row(scan, signal, **kw):
+    row = {
+        'Scan_Date': scan, 'Signal_Date': signal, 'Symbol': 'TKR', 'SecType': 'STK',
+        'Exchange': 'SMART', 'Action': 'BUY', 'Quantity': 100, 'Order_Type': 'REL_CLOSE',
+        'Limit_Price': 0.0, 'Manual_Limit': '', 'Offset_ATR_Mult': 0.25, 'Entry_Offset_ATR': '',
+        'TIF': 'GTC', 'Frozen_ATR': 2.0, 'Signal_Close': 100.0, 'Signal_High': 101.0,
+        'Time_Exit_Date': '2026-10-15', 'Strategy_Ref': 'St OS Sznl',
+        'Tgt_ATR_Mult': 2.0, 'Stop_ATR_Mult': 1.0, 'Use_Target': True, 'Use_Stop': True,
+        'Hold_Days': 10, 'Fill_Window_Days': 10, 'Trade_Direction': 'Long',
+        'Rank_252D': '', 'Risk_Amt': 1000.0, 'Risk_Bps': 20,
+        'Path1_Bps': '', 'Path2_Bps': '', 'Path2_Daily_Cap_Pct': '', 'T1_Open_Filters': '',
+        'MonGapKill_ATR': '', 'MonGapKill_Weekdays': '', 'MonGapKill_Dir': '',
+        'Account_Value': staging.ACCOUNT_VALUE,
+    }
+    row.update(kw)
+    return row
+
+
+def _run_chain(monkeypatch, tmp_path, liquid_rows, overflow_rows):
+    written = {}
+    monkeypatch.setattr(staging, 'connect_to_ibkr', lambda: (None, False))
+    monkeypatch.setattr(staging, '_read_staging_tabs_with_retry', lambda p: (
+        object(), pd.DataFrame(liquid_rows), pd.DataFrame(overflow_rows)))
+    monkeypatch.setattr(staging, 'update_execution_tab',
+                        lambda sh, df: written.__setitem__('execution', df.copy()) or True)
+    monkeypatch.setattr(staging, 'update_execution_tab_2',
+                        lambda sh, df: written.__setitem__('execution_2', df.copy()) or True)
+    monkeypatch.setattr(staging, 'fetch_pa_account_value', lambda: 200_000.0)
+    monkeypatch.setattr(staging, 'load_trend_rows', lambda sh: pd.DataFrame())
+    monkeypatch.setattr(staging, 'OUTPUT_FOLDER', str(tmp_path))
+    rc = staging.pull_and_stage_orders()
+    return rc, written
+
+
+def test_chain_oct1_scenario_stages_nothing(monkeypatch, tmp_path, capsys):
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    rc, written = _run_chain(monkeypatch, tmp_path, [],
+                             [_full_row('2026-09-30', '2026-09-29', Symbol='FORM')])
+    out = capsys.readouterr().out
+    assert rc is not False
+    assert written == {}
+    assert not (tmp_path / 'staged_orders.csv').exists()
+    assert '[CRITICAL] Dropped 1 overflow rows' in out and 'No orders to process' in out
+
+
+def test_chain_normal_day_stages_row(monkeypatch, tmp_path, capsys):
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    rc, written = _run_chain(monkeypatch, tmp_path,
+                             [_full_row('2026-10-01', '2026-09-30')], [])
+    assert rc is not False
+    assert list(written['execution']['Symbol']) == ['TKR']
+    assert written['execution']['Staged_Date'].iloc[0] == '2026-10-01'
+    assert 'Dropped' not in capsys.readouterr().out
+
+
+def test_chain_timezone_signal_does_not_abort_staging(monkeypatch, tmp_path, capsys):
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    rc, written = _run_chain(monkeypatch, tmp_path,
+        [_full_row('2026-09-30', '2026-09-29T00:00:00+00:00')], [])
+    assert rc is not False
+    assert list(written['execution']['Symbol']) == ['TKR']
+    assert '[CRITICAL] liquid prior-day pre-market filter failed' in capsys.readouterr().out
