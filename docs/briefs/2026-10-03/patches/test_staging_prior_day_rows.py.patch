+# --- 4. preserve_unavailable retention (daily_scan.save_staging_orders) -----
+def test_retained_rows_pm_kept_am_dropped(monkeypatch):
+    _freeze(monkeypatch, '2026-10-01 09:31')
+    tab = pd.DataFrame([
+        _row('NEW', '2026-10-01', '2026-09-30'),        # today's scan
+        _row('KEEPPM', '2026-09-30', '2026-09-30'),     # retained 9/30 PM obligation
+        _row('OLDAM', '2026-09-30', '2026-09-29'),      # retained 9/30 AM row: 9/30's entry
+    ])
+    assert list(_load(tab)['Symbol']) == ['NEW', 'KEEPPM']
