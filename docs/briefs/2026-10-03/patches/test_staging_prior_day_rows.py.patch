+                        _row('XME', '2026-10-01', '2026-09-30', 'Oversold Low Volume', 'BUY')])
+    after_cutoff = staging.filter_stale_overflow(tab)
+    out = staging.filter_prior_day_premarket_rows(after_cutoff)
