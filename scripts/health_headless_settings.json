{
  "_comment": "Scoped allowlist for unattended local-primary health diagnosis: the receipt/data battery, GitHub backup inspection, targeted pytest, and the verdict report. No web, broker writes, producer reruns, or code mutation; the battery alone maintains its PIT tripwire state.",
  "permissions": {
    "allow": [
      "Skill",
      "Bash(python scripts/repo_health_check.py:*)",
      "Bash(python scripts/check_pitch_delivered.py:*)",
      "Bash(python scripts/check_context_delivered.py:*)",
      "Bash(python -m pytest:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Read",
      "Glob",
      "Grep",
      "Write(scripts/logs/**)",
      "TodoWrite"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.json)",
      "Read(**/token.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit",
      "WebSearch",
      "WebFetch"
    ]
  }
}
