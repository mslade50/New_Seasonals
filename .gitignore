data/earnings_calendar_overflow.parquet

# Runtime / generated artifacts
logs/
Weekly_Market_Rundown_*.pdf

# ML layer artifacts (datasets, models, reports, daily scores — regenerated
# by ml/dataset.py, ml/train.py, ml/evaluate.py, ml/score_daily.py; model
# distributed via R2 key ml/meta_model_latest.joblib)
data/ml/
data/fundamental/

# Private site build output (regenerated by scripts/build_site.py; deployed
# to Cloudflare Pages by deploy_site.yml — never committed)
dist/
dist-shared/
data/site_risk.json

# Per-trade signal charts (regenerated by scripts/build_signal_charts.py;
# stored in R2 under charts/ + served lazily on the private site — never committed)
charts/

# Backtest ledger + portfolio HTML view outputs (regenerated by scripts/refresh_view.py)
reports/
scripts/trade_ledger_summary.csv
scripts/olv_clusters.csv
scripts/olv_episode_returns.csv
scripts/olv_trades.csv
scripts/atr_gap_overflow_trades.csv
scripts/atr_gap_overflow_trades.parquet

# Streamlit watcher temp files
pages/*.tmp.*
pages/*.py.tmp.*

# Local Claude Code config (settings, caches). Project SKILLS are committed:
# .claude/skills/daily-pitch is the Daily Pitch pipeline's stage B-D process,
# not a personal setting.
.claude/*
!.claude/skills/

# Wrangler local state (OAuth cache, logs) + local npx/npm installs
.wrangler/
node_modules/
package-lock.json

# Large generated data (re-built by build scripts)
atr_seasonal_ranks.csv
# atr_seasonal_ranks.parquet exceeds GitHub's 100 MB limit at full universe;
# distributed via R2 (key: atr_seasonal_ranks.parquet) instead of git.
atr_seasonal_ranks.parquet
*.db

# Environment / IDE
.env
.venv/
*.egg-info/

# Daily Pitch generated inputs (rebuilt every morning by build_pitch_state.py
# and the /daily-pitch skill). The JOURNAL and SCOREBOARD are committed on
# purpose: they are the product's evidence trail.
data/pitch_state.json
data/pitch_tape.json
data/pitch_research_index.json
data/pitch_ideas.json
scripts/logs/

# Market Context generated inputs (rebuilt every evening by
# build_context_state.py) and the briefs themselves. The BRIEFS are local-only
# by decision (McKinley 2026-08-09): they are a Slack product, not a repo
# artifact. The JOURNAL and the novelty FLAG STATE are committed on purpose -
# the journal is the audit trail of what was claimed, and the flag state is
# what stops tomorrow's brief from repeating tonight's.
data/context_state.json
data/context_cells.json
data/context_tape.json
data/context_briefs/
# scratch/context_checks/ is NOT ignored: the journal's drill_script field
# points into it, so those scripts are the audit trail, exactly as
# scratch/pitch_checks/ is for the Daily Pitch.

# Daily Posts (the pseudonymous X account) generated inputs and the daily
# draft queue. The QUEUE is local-only like the context briefs: drafts are a
# publishing product, and unposted ideas are material we may still use. The
# JOURNAL and SCOREBOARD are committed on purpose - same evidence-trail rule
# as the pitch.
data/posts_state.json
content/queue/

# Repo health check tripwire state - machine-local, advanced every run
data/health_check_state.json
